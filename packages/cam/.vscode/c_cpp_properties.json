{
    "configurations": [
        {
            "name": "ESP-IDF",
            "compilerPath": "${default}",
            "compileCommands": [
                "${config:idf.buildPath}/compile_commands.json"
            ],
            "intelliSenseMode": "gcc-x86",
            "includePath": [
                "${env:HOME}/esp/esp-idf/v6.0/components/**",
                "${env:HOME}/esp/esp-idf/v6.0/components/lwip/include",
                "${workspaceFolder}/**"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}